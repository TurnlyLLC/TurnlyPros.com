{
  "routes": [
    {
      "src": "^/blog/?$",
      "dest": "/blog/index.html"
    },
    {
      "src": "^/blog/([a-z0-9-]+)/?$",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "^/blog/(blog\\.css|sitemap\\.xml)$",
      "dest": "/blog/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "/residential/index.html"
    },
    {
      "src": "^/((?!residential/).*)$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "/residential/$1"
    },
    {
      "src": "^/f(?:/.*)?$",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/feedback/index.html"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "turnlypros.com"
        }
      ],
      "dest": "/residential/index.html"
    },
    {
      "src": "^/((?!residential/|resident-feedback\\.(?:js|css)$|feedback/).*)$",
      "has": [
        {
          "type": "host",
          "value": "turnlypros.com"
        }
      ],
      "dest": "/residential/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "www.turnlypros.com"
        }
      ],
      "dest": "/residential/index.html"
    },
    {
      "src": "^/((?!residential/|resident-feedback\\.(?:js|css)$|feedback/).*)$",
      "has": [
        {
          "type": "host",
          "value": "www.turnlypros.com"
        }
      ],
      "dest": "/residential/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "/residential/index.html"
    },
    {
      "src": "^/((?!residential/).*)$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "/residential/$1"
    },
    {
      "handle": "filesystem"
    }
  ],
  "github": {
    "silent": true
  },
  "buildCommand": "node scripts/build-blog.cjs",
  "outputDirectory": "."
}
