{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "destination": "/residential/index.html"
    },
    {
      "source": "/:path((?!residential/).*)",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "destination": "/residential/:path"
    }
  ]
}
